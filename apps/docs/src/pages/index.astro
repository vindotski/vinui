---
import Layout from "../layouts/Layout.astro"
import { ReactButtons } from "../components/ReactButtons"
import VueButtons from "../components/VueButtons.vue"
---

<Layout title="vinui">
  <main class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-10 flex items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold">vinui</h1>
        <p class="text-muted-foreground text-sm">Button — same classes, two frameworks.</p>
      </div>
      <button
        id="theme-toggle"
        class="btn btn-outline btn-sm"
        type="button"
      >
        Toggle dark
      </button>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      <section class="border-border rounded-lg border p-6">
        <h2 class="text-muted-foreground mb-4 text-sm font-medium">React · Base UI</h2>
        <ReactButtons client:load />
      </section>
      <section class="border-border rounded-lg border p-6">
        <h2 class="text-muted-foreground mb-4 text-sm font-medium">Vue · Reka UI</h2>
        <VueButtons client:load />
      </section>
    </div>
  </main>

  <script>
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      document.documentElement.classList.toggle("dark")
    })
  </script>
</Layout>
