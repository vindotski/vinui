---
import Demo from "../components/Demo.astro"
import Layout from "../layouts/Layout.astro"
import { ReactButtons } from "../components/ReactButtons"
import { ReactDialog } from "../components/ReactDialog"
import VueButtons from "../components/VueButtons.vue"
import VueDialog from "../components/VueDialog.vue"
import SvelteButtons from "../components/SvelteButtons.svelte"
import SvelteDialog from "../components/SvelteDialog.svelte"
---

<Layout title="vinui">
  <main class="mx-auto max-w-5xl px-4 py-12">
    <div class="mb-10">
      <h1 class="text-2xl font-semibold">Components</h1>
      <p class="text-muted-foreground text-sm">Same classes, three web frameworks.</p>
    </div>

    <!-- Slots go on Fragment, not the island: a `slot` attr would be passed to the
         component as a prop on the client only, causing a hydration mismatch. -->
    <Demo title="Button">
      <Fragment slot="react"><ReactButtons client:load /></Fragment>
      <Fragment slot="vue"><VueButtons client:load /></Fragment>
      <Fragment slot="svelte"><SvelteButtons client:load /></Fragment>
    </Demo>

    <Demo title="Dialog">
      <Fragment slot="react"><ReactDialog client:load /></Fragment>
      <Fragment slot="vue"><VueDialog client:load /></Fragment>
      <Fragment slot="svelte"><SvelteDialog client:load /></Fragment>
    </Demo>
  </main>

</Layout>
