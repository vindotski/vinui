---
import { selectTriggerProps } from "@vinui/core"

import CodeBlock from "../../../components/CodeBlock.astro"
import FrameworkTabs from "../../../components/FrameworkTabs.astro"
import InstallCommand from "../../../components/InstallCommand.astro"
import NativePreview from "../../../components/NativePreview.astro"
import NativeWebPreview from "../../../components/NativeWebPreview.astro"
import PropsTable from "../../../components/PropsTable.astro"
import { ReactSelect } from "../../../components/ReactSelect"
import VueSelect from "../../../components/VueSelect.vue"
import SvelteSelect from "../../../components/SvelteSelect.svelte"
import { svelteAdd } from "../../../lib/registry"
import DocsLayout from "../../../layouts/DocsLayout.astro"

const usage = {
  react: `
import {
  Select,
  SelectContent,
  SelectGroup,
  SelectItem,
  SelectLabel,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select"

export function Example() {
  return (
    <Select>
      <SelectTrigger className="w-44">
        <SelectValue placeholder="Pick a fruit" />
      </SelectTrigger>
      <SelectContent>
        <SelectGroup>
          <SelectLabel>Fruits</SelectLabel>
          <SelectItem value="apple">Apple</SelectItem>
          <SelectItem value="banana">Banana</SelectItem>
          <SelectItem value="grapes" disabled>Grapes</SelectItem>
        </SelectGroup>
      </SelectContent>
    </Select>
  )
}`,
  vue: `
<script setup lang="ts">
import {
  Select,
  SelectContent,
  SelectGroup,
  SelectItem,
  SelectLabel,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select"
</script>

<template>
  <Select>
    <SelectTrigger class="w-44">
      <SelectValue placeholder="Pick a fruit" />
    </SelectTrigger>
    <SelectContent>
      <SelectGroup>
        <SelectLabel>Fruits</SelectLabel>
        <SelectItem value="apple">Apple</SelectItem>
        <SelectItem value="banana">Banana</SelectItem>
        <SelectItem value="grapes" disabled>Grapes</SelectItem>
      </SelectGroup>
    </SelectContent>
  </Select>
</template>`,
  svelte: `
<script lang="ts">
  import * as Select from "#lib/components/ui/select/index.js"

  const fruits = [
    { value: "apple", label: "Apple" },
    { value: "banana", label: "Banana" },
    { value: "grapes", label: "Grapes", disabled: true },
  ]
  let value = $state("")
</script>

<Select.Root type="single" items={fruits} bind:value>
  <Select.Trigger class="w-44">
    <Select.Value placeholder="Pick a fruit" />
  </Select.Trigger>
  <Select.Content>
    <Select.Group>
      <Select.Label>Fruits</Select.Label>
      {#each fruits as fruit (fruit.value)}
        <Select.Item value={fruit.value} label={fruit.label} disabled={fruit.disabled}>
          {fruit.label}
        </Select.Item>
      {/each}
    </Select.Group>
  </Select.Content>
</Select.Root>`,
  native: `
import {
  Select,
  SelectContent,
  SelectGroup,
  SelectItem,
  SelectLabel,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select"

export function Example() {
  return (
    <Select>
      <SelectTrigger className="w-44">
        <SelectValue placeholder="Pick a fruit" />
      </SelectTrigger>
      <SelectContent className="w-44">
        <SelectGroup>
          <SelectLabel>Fruits</SelectLabel>
          <SelectItem value="apple" label="Apple" />
          <SelectItem value="banana" label="Banana" />
          <SelectItem value="grapes" label="Grapes" disabled />
        </SelectGroup>
      </SelectContent>
    </Select>
  )
}`,
}

const controlled = {
  react: `
const [size, setSize] = React.useState("m")

<Select value={size} onValueChange={setSize}>
  …
</Select>`,
  vue: `
<script setup lang="ts">
import { ref } from "vue"

const size = ref("m")
</script>

<template>
  <Select v-model="size">
    …
  </Select>
</template>`,
  svelte: `
<script lang="ts">
  let size = $state("m")
</script>

<Select.Root type="single" {items} bind:value={size}>
  …
</Select.Root>`,
  native: `
import { type Option } from "@/components/ui/select"

const [size, setSize] = React.useState<Option>({ value: "m", label: "Medium" })

<Select value={size} onValueChange={setSize}>
  …
</Select>`,
}

const small = {
  react: `<SelectTrigger size="sm">`,
  vue: `<SelectTrigger size="sm">`,
  svelte: `<Select.Trigger size="sm">`,
  native: `<SelectTrigger size="sm">`,
}

const position = {
  react: `<SelectContent position="popper">`,
  vue: `<SelectContent position="item-aligned">`,
}
---

<DocsLayout title="Select">
  <h1>Select</h1>
  <p class="lead">Displays a list of options to pick one from, opened by a button.</p>

  <FrameworkTabs label="Preview">
    <div slot="react" class="border-border rounded-lg border p-6"><ReactSelect client:load /></div>
    <div slot="vue" class="border-border rounded-lg border p-6"><VueSelect client:load /></div>
    <div slot="svelte" class="border-border rounded-lg border p-6"><SvelteSelect client:load /></div>
    <div slot="native">
      <NativeWebPreview demo="select" title="Select demo" minHeight={380} />
      <NativePreview shot="select-open" />
      <p class="text-muted-foreground mt-3 text-xs">Device screenshots of the native playground's release build.</p>
    </div>
  </FrameworkTabs>

  <h2 id="installation">Installation</h2>
  <p>The same item, <code>@vinui/select</code>, on every framework (Svelte takes its URL). Set up vinui first (<a href="/docs/installation/react">React</a>, <a href="/docs/installation/vue">Vue</a>, <a href="/docs/installation/svelte">Svelte</a>, <a href="/docs/installation/react-native">React Native</a>), then:</p>
  <FrameworkTabs label="Installation">
    <InstallCommand slot="react" framework="react" args="add @vinui/select" />
    <InstallCommand slot="vue" framework="vue" args="add @vinui/select" />
    <InstallCommand slot="svelte" framework="svelte" args={svelteAdd("select")} />
    <div slot="native">
      <InstallCommand framework="native" args="add @vinui/select" />
      <p>It needs Reanimated and React Native Screens, which vinui's setup installs with <code>npx expo install</code> so their versions match your Expo SDK.</p>
    </div>
  </FrameworkTabs>

  <h2 id="usage">Usage</h2>
  <FrameworkTabs label="Usage">
    <CodeBlock slot="react" code={usage.react} lang="tsx" />
    <CodeBlock slot="vue" code={usage.vue} lang="vue" />
    <div slot="svelte">
      <CodeBlock code={usage.svelte} lang="svelte" />
      <p>
        Bits UI needs <code>type="single"</code> on the root. Pass the options as <code>items</code> too, so the trigger shows the chosen label before the list has opened, and give each item a <code>label</code>: typeahead searches it.
      </p>
    </div>
    <div slot="native">
      <CodeBlock code={usage.native} lang="tsx" />
      <p>
        Each item takes a <code>value</code> and a <code>label</code>; a plain string child works as the label too (<code>&lt;SelectItem value="apple"&gt;Apple&lt;/SelectItem&gt;</code>). The list renders into a <code>&lt;PortalHost /&gt;</code>; vinui's <code>ThemeRoot</code> renders one at the app root.
      </p>
    </div>
  </FrameworkTabs>

  <h3 id="controlled">Controlled</h3>
  <p>Keep the value in your own state.</p>
  <FrameworkTabs label="Controlled">
    <CodeBlock slot="react" code={controlled.react} lang="tsx" />
    <CodeBlock slot="vue" code={controlled.vue} lang="vue" />
    <CodeBlock slot="svelte" code={controlled.svelte} lang="svelte" />
    <div slot="native">
      <CodeBlock code={controlled.native} lang="tsx" />
      <p>On React Native the value is an <code>Option</code>, <code>{"{ value, label }"}</code>, not a string: that's what rn-primitives works with.</p>
    </div>
  </FrameworkTabs>

  <h3 id="small">Small trigger</h3>
  <p>A 32px trigger, for dense layouts.</p>
  <FrameworkTabs label="Small trigger">
    <CodeBlock slot="react" code={small.react} lang="tsx" />
    <CodeBlock slot="vue" code={small.vue} lang="vue" />
    <CodeBlock slot="svelte" code={small.svelte} lang="svelte" />
    <CodeBlock slot="native" code={small.native} lang="tsx" />
  </FrameworkTabs>

  <h3 id="position">Position</h3>
  <p>
    <code>"item-aligned"</code> opens the list over the trigger with the chosen option lined up on it, as a native <code>&lt;select&gt;</code> does. <code>"popper"</code> opens it below the trigger. Each framework keeps its reference's default:
  </p>
  <FrameworkTabs label="Position">
    <div slot="react">
      <CodeBlock code={position.react} lang="tsx" />
      <p>React defaults to <code>"item-aligned"</code>, as shadcn/ui does.</p>
    </div>
    <div slot="vue">
      <CodeBlock code={position.vue} lang="vue" />
      <p>Vue defaults to <code>"popper"</code>, as shadcn-vue does.</p>
    </div>
    <p slot="svelte">Bits UI always opens the list below the trigger (a popper); there's no <code>position</code> prop.</p>
    <p slot="native">React Native always opens the list below the trigger (<code>"popper"</code>), as RN Reusables does.</p>
  </FrameworkTabs>

  <h2 id="api-reference">API reference</h2>
  <p>Only the props vinui adds are listed. Everything else (<code>value</code>, <code>defaultValue</code>, <code>disabled</code>, <code>name</code>, events) comes from the primitives:</p>
  <FrameworkTabs label="API reference">
    <div slot="react">
      <p>See <a href="https://www.radix-ui.com/primitives/docs/components/select">Radix Select</a>.</p>
      <h4 id="select-trigger-react"><code>SelectTrigger</code></h4>
      <PropsTable props={selectTriggerProps} framework="react" />
    </div>
    <div slot="vue">
      <p>See <a href="https://reka-ui.com/docs/components/select">Reka UI Select</a>. <code>SelectItem</code> also has an <code>indicator-icon</code> slot for the check mark.</p>
      <h4 id="select-trigger-vue"><code>SelectTrigger</code></h4>
      <PropsTable props={selectTriggerProps} framework="vue" />
    </div>
    <div slot="svelte">
      <p>See <a href="https://bits-ui.com/docs/components/select">Bits UI Select</a>. <code>SelectContent</code> also takes shadcn-svelte's <code>portalProps</code>.</p>
      <h4 id="select-trigger-svelte"><code>SelectTrigger</code></h4>
      <PropsTable props={selectTriggerProps} framework="svelte" />
    </div>
    <div slot="native">
      <p>See <a href="https://rnprimitives.com/select">rn-primitives Select</a>. <code>SelectContent</code> also takes a <code>portalHost</code> name.</p>
      <h4 id="select-trigger-native"><code>SelectTrigger</code></h4>
      <PropsTable props={selectTriggerProps} framework="native" />
    </div>
  </FrameworkTabs>

  <h2 id="platform-notes">Platform notes</h2>
  <FrameworkTabs label="Platform notes">
    <ul slot="react">
      <li>Every part sets <code>data-slot</code> (<code>select-trigger</code>, <code>select-item</code>, …). The trigger sets <code>data-size</code> and, with no value, <code>data-placeholder</code>; the list sets <code>data-state</code> and, as a popper, <code>data-side</code>.</li>
      <li>Keyboard: arrows move between options and skip disabled ones, typing jumps to a matching option, Enter chooses, Escape closes.</li>
      <li>The open and close animations are CSS keyed on <code>data-state</code>, and turn off with <code>prefers-reduced-motion</code>.</li>
    </ul>
    <ul slot="vue">
      <li>The same <code>data-*</code> attributes and keyboard behaviour as on React.</li>
      <li>Bind the value with <code>v-model</code>; <code>SelectItemText</code> is exported for custom items, as in shadcn-vue.</li>
    </ul>
    <ul slot="svelte">
      <li>The same <code>data-*</code> attributes and keyboard behaviour as on React. Bits UI marks the highlighted option with <code>data-highlighted</code>.</li>
      <li>Disabled options get <code>aria-disabled</code>, which Bits UI leaves out (a vinui addition).</li>
      <li><code>sideOffset</code> defaults to 0 (shadcn-svelte: 4): the 4px gap comes from vinui's CSS, so <code>sideOffset</code> adds the same extra space as on React and Vue.</li>
      <li>Headings for groups: <code>Select.Label</code> is a plain <code>div</code>, as in shadcn-svelte; <code>Select.GroupHeading</code> also names its group for screen readers.</li>
    </ul>
    <ul slot="native">
      <li>Tapping outside the list closes it, and so does the Android back button.</li>
      <li>The list fades in and out with Reanimated and follows the system's Reduce Motion setting.</li>
      <li>The scroll arrows show on web only; on devices the list scrolls natively.</li>
      <li>On react-native-web the trigger is announced as a combobox, as on the web ports (rn-primitives would announce a plain button).</li>
      <li>No <code>data-*</code> attributes: state comes from props.</li>
    </ul>
  </FrameworkTabs>
</DocsLayout>
