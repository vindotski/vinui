---
import { buttonProps } from "@vinui/core"

import CodeBlock from "../../../components/CodeBlock.astro"
import FrameworkTabs from "../../../components/FrameworkTabs.astro"
import InstallCommand from "../../../components/InstallCommand.astro"
import NativePreview from "../../../components/NativePreview.astro"
import NativeWebPreview from "../../../components/NativeWebPreview.astro"
import PropsTable from "../../../components/PropsTable.astro"
import { ReactButtons } from "../../../components/ReactButtons"
import VueButtons from "../../../components/VueButtons.vue"
import SvelteButtons from "../../../components/SvelteButtons.svelte"
import { svelteAdd } from "../../../lib/registry"
import DocsLayout from "../../../layouts/DocsLayout.astro"

const usage = {
  react: `
import { Button } from "@/components/ui/button"

export function Example() {
  return <Button variant="outline">Button</Button>
}`,
  vue: `
<script setup lang="ts">
import { Button } from "@/components/ui/button"
</script>

<template>
  <Button variant="outline">Button</Button>
</template>`,
  svelte: `
<script lang="ts">
  import { Button } from "#lib/components/ui/button/index.js"
</script>

<Button variant="outline">Button</Button>`,
  native: `
import { Button } from "@/components/ui/button"

export function Example() {
  return (
    <Button variant="outline" onPress={() => console.log("pressed")}>
      Button
    </Button>
  )
}`,
}

const link = {
  react: `
<Button asChild>
  <a href="/login">Login</a>
</Button>`,
  vue: `
<Button as-child>
  <a href="/login">Login</a>
</Button>`,
  svelte: `
<Button href="/login">Login</Button>`,
  native: `
import { Link } from "expo-router"

<Link href="/login" asChild>
  <Button>Login</Button>
</Link>`,
}

const variantsHelper = {
  react: `
import { buttonVariants } from "@/components/ui/button"

<a href="/docs" className={buttonVariants({ variant: "outline" })}>
  Docs
</a>`,
  vue: `
<script setup lang="ts">
import { buttonVariants } from "@/components/ui/button"
</script>

<template>
  <a href="/docs" :class="buttonVariants({ variant: 'outline' })">Docs</a>
</template>`,
  svelte: `
<script lang="ts">
  import { buttonVariants } from "#lib/components/ui/button/index.js"
</script>

<a href="/docs" class={buttonVariants({ variant: "outline" })}>Docs</a>`,
  native: `
import { Pressable } from "react-native"

import { buttonTextVariants, buttonVariants } from "@/components/ui/button"
import { Text } from "@/components/ui/text"

<Pressable className={buttonVariants({ variant: "outline" })}>
  <Text className={buttonTextVariants({ variant: "outline" })}>Docs</Text>
</Pressable>`,
}
---

<DocsLayout title="Button">
  <h1>Button</h1>
  <p class="lead">Displays a button, or something that looks like one.</p>

  <FrameworkTabs label="Preview">
    <div slot="react" class="border-border rounded-lg border p-6"><ReactButtons client:load /></div>
    <div slot="vue" class="border-border rounded-lg border p-6"><VueButtons client:load /></div>
    <div slot="svelte" class="border-border rounded-lg border p-6"><SvelteButtons client:load /></div>
    <div slot="native">
      <NativeWebPreview demo="button" title="Button demo" />
      <NativePreview shot="button-default" />
      <p class="text-muted-foreground mt-3 text-xs">Device screenshots of the native playground's release build.</p>
    </div>
  </FrameworkTabs>

  <h2 id="installation">Installation</h2>
  <p>The same item, <code>@vinui/button</code>, on every framework (Svelte takes its URL). Set up vinui first (<a href="/docs/installation/react">installation</a>), then:</p>
  <FrameworkTabs label="Installation">
    <InstallCommand slot="react" framework="react" args="add @vinui/button" />
    <InstallCommand slot="vue" framework="vue" args="add @vinui/button" />
    <InstallCommand slot="svelte" framework="svelte" args={svelteAdd("button")} />
    <InstallCommand slot="native" framework="native" args="add @vinui/button" />
  </FrameworkTabs>

  <h2 id="usage">Usage</h2>
  <FrameworkTabs label="Usage">
    <CodeBlock slot="react" code={usage.react} lang="tsx" />
    <CodeBlock slot="vue" code={usage.vue} lang="vue" />
    <CodeBlock slot="svelte" code={usage.svelte} lang="svelte" />
    <div slot="native">
      <CodeBlock code={usage.native} lang="tsx" />
      <p>Strings and numbers are wrapped in vinui's <code>Text</code> for you; <code>&lt;Button&gt;&lt;Text&gt;Button&lt;/Text&gt;&lt;/Button&gt;</code> works too.<span class="badge">vinui addition</span></p>
    </div>
  </FrameworkTabs>

  <h3 id="link">Link</h3>
  <FrameworkTabs label="Link">
    <div slot="react">
      <p>Use <code>asChild</code> to render another element, such as a link, with the button's styles.</p>
      <CodeBlock code={link.react} lang="tsx" />
    </div>
    <div slot="vue">
      <p>Use <code>as-child</code> to render another element, such as a link, with the button's styles.</p>
      <CodeBlock code={link.vue} lang="vue" />
    </div>
    <div slot="svelte">
      <p>Pass <code>href</code> and the button renders an <code>&lt;a&gt;</code>. With <code>disabled</code>, the link loses its <code>href</code> and leaves the tab order. To give another component the button's styles, use <a href="#button-variants"><code>buttonVariants</code></a> or that component's <code>child</code> snippet.</p>
      <CodeBlock code={link.svelte} lang="svelte" />
    </div>
    <div slot="native">
      <p>Put the router's link <em>around</em> the button: <code>Link asChild</code> passes navigation to the Button, which keeps its centred label. Button's own <code>asChild</code> needs a box child (a <code>Pressable</code> or anything that renders a <code>View</code>); a bare <code>Text</code> can't centre its label.</p>
      <CodeBlock code={link.native} lang="tsx" />
    </div>
  </FrameworkTabs>

  <h3 id="button-variants"><code>buttonVariants</code></h3>
  <p>The button's classes as a function, for elements that should look like a button. It mirrors cva: pass <code>variant</code>, <code>size</code>, and extra classes as <code>class</code> or <code>className</code>.</p>
  <FrameworkTabs label="buttonVariants">
    <CodeBlock slot="react" code={variantsHelper.react} lang="tsx" />
    <CodeBlock slot="vue" code={variantsHelper.vue} lang="vue" />
    <CodeBlock slot="svelte" code={variantsHelper.svelte} lang="svelte" />
    <div slot="native">
      <p>React Native text doesn't inherit styles, so the label takes <code>buttonTextVariants</code>.</p>
      <CodeBlock code={variantsHelper.native} lang="tsx" />
    </div>
  </FrameworkTabs>

  <h2 id="api-reference">API reference</h2>
  <FrameworkTabs label="API reference">
    <div slot="react">
      <PropsTable props={buttonProps} framework="react" />
      <p>Other props go to the <code>&lt;button&gt;</code> (or to the child with <code>asChild</code>).</p>
    </div>
    <div slot="vue">
      <PropsTable props={buttonProps} framework="vue" />
      <p>Other attributes go to the <code>&lt;button&gt;</code> (or to the child with <code>as-child</code>).</p>
    </div>
    <div slot="svelte">
      <PropsTable props={buttonProps} framework="svelte" />
      <p>Other attributes go to the <code>&lt;button&gt;</code> (or the <code>&lt;a&gt;</code> with <code>href</code>). <code>bind:ref</code> gives you the element.</p>
    </div>
    <div slot="native">
      <PropsTable props={buttonProps} framework="native" />
      <p>Other props go to the <a href="https://reactnative.dev/docs/pressable">Pressable</a>. Use <code>onPress</code>; there is no <code>onClick</code>.</p>
    </div>
  </FrameworkTabs>

  <h2 id="platform-notes">Platform notes</h2>
  <FrameworkTabs label="Platform notes">
    <ul slot="react">
      <li>Needs a Radix-based shadcn project (a <code>radix-*</code> or <code>new-york</code> style). In Base UI projects the CLI rewrites <code>asChild</code> to <code>render</code>.</li>
      <li>Sets <code>data-slot="button"</code>, <code>data-variant</code> and <code>data-size</code>.</li>
    </ul>
    <ul slot="vue">
      <li>Sets <code>data-slot="button"</code>, and <code>data-variant</code> / <code>data-size</code> to <code>"default"</code> when they're omitted.<span class="badge">vinui addition</span></li>
    </ul>
    <ul slot="svelte">
      <li>Sets <code>data-slot="button"</code>, <code>data-variant</code> and <code>data-size</code>.<span class="badge">vinui addition</span></li>
      <li>Includes the <code>xs</code> and <code>icon-xs</code> sizes, which shadcn-svelte's Button doesn't have.<span class="badge">vinui addition</span></li>
      <li><code>buttonVariants</code> appends classes with <code>clsx</code>, like cva; shadcn-svelte's uses <code>tailwind-variants</code>, which merges them.</li>
    </ul>
    <ul slot="native">
      <li>Press feedback is the <code>:active</code> tint. Hover styles apply on react-native-web only.</li>
      <li>Disabled buttons get <code>opacity-50</code>, since devices have no <code>:disabled</code>.</li>
      <li>No <code>data-*</code> attributes: state comes from props.</li>
    </ul>
  </FrameworkTabs>
</DocsLayout>
