---
import { dialogContentProps, dialogFooterProps } from "@vinui/core"

import CodeBlock from "../../../components/CodeBlock.astro"
import FrameworkTabs from "../../../components/FrameworkTabs.astro"
import InstallCommand from "../../../components/InstallCommand.astro"
import NativePreview from "../../../components/NativePreview.astro"
import PropsTable from "../../../components/PropsTable.astro"
import { ReactDialog } from "../../../components/ReactDialog"
import VueDialog from "../../../components/VueDialog.vue"
import DocsLayout from "../../../layouts/DocsLayout.astro"

const usage = {
  react: `
import { Button } from "@/components/ui/button"
import {
  Dialog,
  DialogClose,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog"

export function Example() {
  return (
    <Dialog>
      <DialogTrigger asChild>
        <Button variant="outline">Open dialog</Button>
      </DialogTrigger>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>Delete project?</DialogTitle>
          <DialogDescription>
            This permanently removes the project and all of its data.
          </DialogDescription>
        </DialogHeader>
        <DialogFooter>
          <DialogClose asChild>
            <Button variant="outline">Cancel</Button>
          </DialogClose>
          <Button variant="destructive">Delete</Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  )
}`,
  vue: `
<script setup lang="ts">
import { Button } from "@/components/ui/button"
import {
  Dialog,
  DialogClose,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog"
</script>

<template>
  <Dialog>
    <DialogTrigger as-child>
      <Button variant="outline">Open dialog</Button>
    </DialogTrigger>
    <DialogContent>
      <DialogHeader>
        <DialogTitle>Delete project?</DialogTitle>
        <DialogDescription>
          This permanently removes the project and all of its data.
        </DialogDescription>
      </DialogHeader>
      <DialogFooter>
        <DialogClose as-child>
          <Button variant="outline">Cancel</Button>
        </DialogClose>
        <Button variant="destructive">Delete</Button>
      </DialogFooter>
    </DialogContent>
  </Dialog>
</template>`,
  native: `
import { Button } from "@/components/ui/button"
import {
  Dialog,
  DialogClose,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog"

export function Example() {
  return (
    <Dialog>
      <DialogTrigger asChild>
        <Button variant="outline">Open dialog</Button>
      </DialogTrigger>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>Delete project?</DialogTitle>
          <DialogDescription>
            This permanently removes the project and all of its data.
          </DialogDescription>
        </DialogHeader>
        <DialogFooter>
          <DialogClose asChild>
            <Button variant="outline">Cancel</Button>
          </DialogClose>
          <Button variant="destructive">Delete</Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  )
}`,
}

const footerClose = {
  react: `
<DialogContent showCloseButton={false}>
  <DialogHeader>
    <DialogTitle>Saved</DialogTitle>
    <DialogDescription>Your changes were saved.</DialogDescription>
  </DialogHeader>
  <DialogFooter showCloseButton />
</DialogContent>`,
  vue: `
<DialogContent :show-close-button="false">
  <DialogHeader>
    <DialogTitle>Saved</DialogTitle>
    <DialogDescription>Your changes were saved.</DialogDescription>
  </DialogHeader>
  <DialogFooter show-close-button />
</DialogContent>`,
  native: `
<DialogContent showCloseButton={false}>
  <DialogHeader>
    <DialogTitle>Saved</DialogTitle>
    <DialogDescription>Your changes were saved.</DialogDescription>
  </DialogHeader>
  <DialogFooter showCloseButton />
</DialogContent>`,
}

const controlled = {
  react: `
const [open, setOpen] = React.useState(false)

<Dialog open={open} onOpenChange={setOpen}>
  …
</Dialog>`,
  vue: `
<script setup lang="ts">
import { ref } from "vue"

const open = ref(false)
</script>

<template>
  <Dialog v-model:open="open">
    …
  </Dialog>
</template>`,
  native: `
const [open, setOpen] = React.useState(false)

<Dialog open={open} onOpenChange={setOpen}>
  …
</Dialog>`,
}
---

<DocsLayout title="Dialog">
  <h1>Dialog</h1>
  <p class="lead">A window overlaid on the page or screen, rendering the content underneath inert.</p>

  <FrameworkTabs label="Preview">
    <div slot="react" class="border-border rounded-lg border p-6"><ReactDialog client:load /></div>
    <div slot="vue" class="border-border rounded-lg border p-6"><VueDialog client:load /></div>
    <div slot="native">
      <NativePreview shot="dialog-open" />
      <p class="text-muted-foreground mt-3 text-xs">Device screenshots of the native playground's release build.</p>
    </div>
  </FrameworkTabs>

  <h2 id="installation">Installation</h2>
  <p>The same item, <code>@vinui/dialog</code>, on every framework. It installs <code>@vinui/button</code> too. Set up vinui first (<a href="/docs/installation/react">installation</a>), then:</p>
  <FrameworkTabs label="Installation">
    <InstallCommand slot="react" framework="react" args="add @vinui/dialog" />
    <InstallCommand slot="vue" framework="vue" args="add @vinui/dialog" />
    <div slot="native">
      <InstallCommand framework="native" args="add @vinui/dialog" />
      <p>It needs Reanimated and React Native Screens, which vinui's setup installs with <code>npx expo install</code> so their versions match your Expo SDK.</p>
    </div>
  </FrameworkTabs>

  <h2 id="usage">Usage</h2>
  <FrameworkTabs label="Usage">
    <CodeBlock slot="react" code={usage.react} lang="tsx" />
    <CodeBlock slot="vue" code={usage.vue} lang="vue" />
    <div slot="native">
      <CodeBlock code={usage.native} lang="tsx" />
      <p>The dialog renders into a <code>&lt;PortalHost /&gt;</code>; vinui's <code>ThemeRoot</code> renders one at the app root. Other text in the panel goes in a <code>Text</code>, as everywhere on React Native.</p>
    </div>
  </FrameworkTabs>

  <h3 id="footer-close">Close button in the footer</h3>
  <p>Hide the corner button and put an outline Close button at the end of the footer.</p>
  <FrameworkTabs label="Close button in the footer">
    <CodeBlock slot="react" code={footerClose.react} lang="tsx" />
    <CodeBlock slot="vue" code={footerClose.vue} lang="vue" />
    <CodeBlock slot="native" code={footerClose.native} lang="tsx" />
  </FrameworkTabs>

  <h3 id="controlled">Controlled</h3>
  <p>Open and close the dialog from your own state, for example after a request finishes.</p>
  <FrameworkTabs label="Controlled">
    <CodeBlock slot="react" code={controlled.react} lang="tsx" />
    <CodeBlock slot="vue" code={controlled.vue} lang="vue" />
    <CodeBlock slot="native" code={controlled.native} lang="tsx" />
  </FrameworkTabs>

  <h2 id="api-reference">API reference</h2>
  <p>Only the props vinui adds are listed. Everything else (<code>open</code>, <code>defaultOpen</code>, <code>modal</code>, events) comes from the primitives:</p>
  <FrameworkTabs label="API reference">
    <div slot="react">
      <p>See <a href="https://www.radix-ui.com/primitives/docs/components/dialog">Radix Dialog</a>.</p>
      <h4 id="dialog-content-react"><code>DialogContent</code></h4>
      <PropsTable props={dialogContentProps} framework="react" />
      <h4 id="dialog-footer-react"><code>DialogFooter</code></h4>
      <PropsTable props={dialogFooterProps} framework="react" />
    </div>
    <div slot="vue">
      <p>See <a href="https://reka-ui.com/docs/components/dialog">Reka UI Dialog</a>. Vue templates also accept the kebab-case names (<code>show-close-button</code>).</p>
      <h4 id="dialog-content-vue"><code>DialogContent</code></h4>
      <PropsTable props={dialogContentProps} framework="vue" />
      <h4 id="dialog-footer-vue"><code>DialogFooter</code></h4>
      <PropsTable props={dialogFooterProps} framework="vue" />
    </div>
    <div slot="native">
      <p>See <a href="https://rnprimitives.com/dialog">rn-primitives Dialog</a>.</p>
      <h4 id="dialog-content-native"><code>DialogContent</code></h4>
      <PropsTable props={dialogContentProps} framework="native" />
      <h4 id="dialog-footer-native"><code>DialogFooter</code></h4>
      <PropsTable props={dialogFooterProps} framework="native" />
    </div>
  </FrameworkTabs>

  <h2 id="platform-notes">Platform notes</h2>
  <FrameworkTabs label="Platform notes">
    <ul slot="react">
      <li>Every part sets <code>data-slot</code> (<code>dialog-content</code>, <code>dialog-footer</code>, …), and the overlay and panel set <code>data-state="open" | "closed"</code>.</li>
      <li>The open and close animations are CSS keyed on <code>data-state</code>, and turn off with <code>prefers-reduced-motion</code>.</li>
    </ul>
    <ul slot="vue">
      <li>Every part sets <code>data-slot</code>, and the overlay and panel set <code>data-state</code>, as on React.</li>
      <li>shadcn-vue's <code>DialogScrollContent</code> isn't available yet.</li>
    </ul>
    <ul slot="native">
      <li>Tapping the overlay closes the dialog, and so does the Android back button.</li>
      <li>On iOS the dialog renders in a full-window overlay, so it stays above native modals and screens.</li>
      <li>The panel is centred with padding around it and a maximum width, so it doesn't touch the edges of small phones or stretch across tablets.</li>
      <li>The fades are Reanimated animations and follow the system's Reduce Motion setting.</li>
      <li>No <code>data-*</code> attributes: state comes from props.</li>
    </ul>
  </FrameworkTabs>
</DocsLayout>
