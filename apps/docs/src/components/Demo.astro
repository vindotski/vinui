---
interface Props {
  title: string
}

const { title } = Astro.props
---

<section class="mb-12">
  <h2 class="mb-4 text-lg font-semibold">{title}</h2>
  <div class="grid gap-6 md:grid-cols-2">
    <div data-framework="react" class="border-border rounded-lg border p-6">
      <h3 class="text-muted-foreground mb-4 text-sm font-medium">React · Base UI</h3>
      <slot name="react" />
    </div>
    <div data-framework="vue" class="border-border rounded-lg border p-6">
      <h3 class="text-muted-foreground mb-4 text-sm font-medium">Vue · Reka UI</h3>
      <slot name="vue" />
    </div>
  </div>
</section>
