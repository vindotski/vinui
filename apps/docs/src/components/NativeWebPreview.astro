---
/**
 * A live "React Native (web)" preview: the native playground's web export
 * (scripts/native-preview.ts) in an iframe. It loads only once the React Native tab
 * is shown, follows the docs' theme, and is sized to its content.
 */
interface Props {
  /** The playground's `?demo=` name. */
  demo: "button" | "dialog"
  /** Accessible name of the frame. */
  title: string
  /** Space the demo needs beyond its content (e.g. an open dialog), in px. */
  minHeight?: number
}

const { demo, title, minHeight = 0 } = Astro.props
---

<figure class="native-web-preview">
  <div class="border-border overflow-hidden rounded-lg border">
    <iframe
      data-native-preview
      data-src={`/native-preview/index.html?demo=${demo}`}
      data-min-height={minHeight}
      title={`${title}, React Native (web)`}
      class="block w-full"
      style={`height: ${Math.max(minHeight, 120)}px`}></iframe>
  </div>
  <figcaption class="text-muted-foreground mt-2 text-xs">
    <span class="badge ml-0!">React Native (web)</span> The native components running in the browser through react-native-web. Devices render natively: see the screenshots below.
  </figcaption>
</figure>

<script>
  const root = document.documentElement
  const frames = () => document.querySelectorAll<HTMLIFrameElement>("iframe[data-native-preview]")
  const theme = () => (root.classList.contains("dark") ? "dark" : "light")
  const sendTheme = (frame: HTMLIFrameElement) =>
    frame.contentWindow?.postMessage({ type: "vinui:theme", theme: theme() }, location.origin)

  /** Frames get their src only once the React Native tab is shown. */
  function load() {
    if (root.dataset.framework !== "native") return
    for (const frame of frames()) {
      if (frame.getAttribute("src")) continue
      const url = new URL(frame.dataset.src!, location.href)
      url.searchParams.set("theme", theme())
      frame.src = url.href
    }
  }

  new MutationObserver(() => {
    load()
    for (const frame of frames()) if (frame.getAttribute("src")) sendTheme(frame)
  }).observe(root, { attributes: true, attributeFilter: ["class", "data-framework"] })

  window.addEventListener("message", (event) => {
    if (event.origin !== location.origin) return
    const frame = [...frames()].find((f) => f.contentWindow === event.source)
    if (!frame) return
    if (event.data?.type === "vinui:preview-ready") sendTheme(frame)
    if (event.data?.type === "vinui:preview-size" && typeof event.data.height === "number") {
      frame.style.height = `${Math.max(Number(frame.dataset.minHeight), event.data.height)}px`
    }
  })

  load()
</script>
