---
/**
 * React / Vue / Svelte / React Native panels. The choice is site-wide and remembered
 * (see Layout.astro): pick Vue once and every page opens on Vue.
 */
interface Props {
  label?: string
}

const { label = "Framework" } = Astro.props
const frameworks = [
  ["react", "React"],
  ["vue", "Vue"],
  ["svelte", "Svelte"],
  ["native", "React Native"],
] as const
const id = `tabs-${Math.random().toString(36).slice(2, 8)}`
---

<div class="framework-tabs">
  <div role="tablist" aria-label={label}>
    {
      frameworks.map(([framework, name]) => (
        <button
          type="button"
          role="tab"
          id={`${id}-${framework}-tab`}
          aria-controls={`${id}-${framework}`}
          aria-selected={framework === "react" ? "true" : "false"}
          data-framework-tab={framework}
        >
          {name}
        </button>
      ))
    }
  </div>
  {
    frameworks.map(([framework]) => (
      <div role="tabpanel" id={`${id}-${framework}`} aria-labelledby={`${id}-${framework}-tab`} data-framework-panel={framework}>
        {framework === "react" && <slot name="react" />}
        {framework === "vue" && <slot name="vue" />}
        {framework === "svelte" && <slot name="svelte" />}
        {framework === "native" && <slot name="native" />}
      </div>
    ))
  }
</div>
