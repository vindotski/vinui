---
import { dlx } from "../lib/pm"
import PmCommand from "./PmCommand.astro"

/** A shadcn CLI command with the framework's CLI (`shadcn-vue` on Vue). */
interface Props {
  framework: "react" | "vue" | "native"
  /** Arguments after the CLI, e.g. `add @vinui/button`. */
  args: string
}

const { framework, args } = Astro.props
const cli = framework === "vue" ? "shadcn-vue@latest" : "shadcn@latest"
---

<PmCommand commands={dlx(`${cli} ${args}`)} />
