---
import "../styles/global.css"

interface Props {
  title: string
}

const { title } = Astro.props
const path = Astro.url.pathname
const nav = [
  { href: "/", label: "Components", active: path === "/" },
  { href: "/docs/installation/react", label: "Installation", active: path.startsWith("/docs") },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      if (matchMedia("(prefers-color-scheme: dark)").matches) {
        document.documentElement.classList.add("dark")
      }
    </script>
  </head>
  <body>
    <header class="border-border border-b">
      <div class="mx-auto flex max-w-5xl items-center gap-6 px-4 py-3">
        <a href="/" class="font-semibold">vinui</a>
        <nav class="flex gap-4 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "hover:text-foreground",
                  item.active ? "text-foreground" : "text-muted-foreground",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex gap-2" role="group" aria-label="Theme">
          {
            ["light", "dark", "system"].map((theme) => (
              <button
                class:list={["btn btn-sm", theme !== "system" && "btn-outline"]}
                type="button"
                data-theme={theme}
                aria-pressed={theme === "system" ? "true" : "false"}
              >
                {theme}
              </button>
            ))
          }
        </div>
      </div>
    </header>
    <slot />
    <script>
      // Light / dark / system, like the native playground. "system" follows the OS live.
      const media = matchMedia("(prefers-color-scheme: dark)")
      const buttons = document.querySelectorAll<HTMLButtonElement>("button[data-theme]")
      let theme = "system"
      function apply() {
        const dark = theme === "dark" || (theme === "system" && media.matches)
        document.documentElement.classList.toggle("dark", dark)
        for (const button of buttons) {
          const selected = button.dataset.theme === theme
          button.setAttribute("aria-pressed", String(selected))
          button.classList.toggle("btn-outline", !selected)
        }
      }
      for (const button of buttons) {
        button.addEventListener("click", () => {
          theme = button.dataset.theme ?? "system"
          apply()
        })
      }
      media.addEventListener("change", apply)
    </script>
  </body>
</html>
