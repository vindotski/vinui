---
import "../styles/global.css"

interface Props {
  title: string
}

const { title } = Astro.props
const path = Astro.url.pathname
const nav = [
  { href: "/", label: "Components", active: path === "/" },
  { href: "/docs/installation/react", label: "Installation", active: path.startsWith("/docs") },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      if (matchMedia("(prefers-color-scheme: dark)").matches) {
        document.documentElement.classList.add("dark")
      }
    </script>
  </head>
  <body>
    <header class="border-border border-b">
      <div class="mx-auto flex max-w-5xl items-center gap-6 px-4 py-3">
        <a href="/" class="font-semibold">vinui</a>
        <nav class="flex gap-4 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "hover:text-foreground",
                  item.active ? "text-foreground" : "text-muted-foreground",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button id="theme-toggle" class="btn btn-outline btn-sm ml-auto" type="button">
          Toggle dark
        </button>
      </div>
    </header>
    <slot />
    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        document.documentElement.classList.toggle("dark")
      })
    </script>
  </body>
</html>
