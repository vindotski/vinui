---
import "../styles/global.css"

interface Props {
  title: string
}

const { title } = Astro.props
const path = Astro.url.pathname
const nav = [
  { href: "/", label: "Components", active: path === "/" || path.startsWith("/docs/components") },
  { href: "/docs/installation/react", label: "Installation", active: path.startsWith("/docs/installation") },
]
---

<!doctype html>
<html lang="en" data-framework="react" data-pm="npm">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      if (matchMedia("(prefers-color-scheme: dark)").matches) {
        document.documentElement.classList.add("dark")
      }
      // Remembered framework tab and package manager, applied before paint (CSS shows the matching panels).
      try {
        const framework = localStorage.getItem("vinui:framework")
        if (["react", "vue", "svelte", "native"].includes(framework)) document.documentElement.dataset.framework = framework
        const pm = localStorage.getItem("vinui:pm")
        if (["npm", "pnpm", "yarn", "bun"].includes(pm)) document.documentElement.dataset.pm = pm
      } catch {}
    </script>
  </head>
  <body>
    <header class="border-border border-b">
      <div class="mx-auto flex max-w-5xl items-center gap-6 px-4 py-3">
        <a href="/" class="font-semibold">vinui</a>
        <nav class="flex gap-4 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "hover:text-foreground",
                  item.active ? "text-foreground" : "text-muted-foreground",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex gap-2" role="group" aria-label="Theme">
          {
            ["light", "dark", "system"].map((theme) => (
              <button
                class:list={["btn btn-sm", theme !== "system" && "btn-outline"]}
                type="button"
                data-theme={theme}
                aria-pressed={theme === "system" ? "true" : "false"}
              >
                {theme}
              </button>
            ))
          }
        </div>
      </div>
    </header>
    <slot />
    <script>
      // Light / dark / system, like the native playground. "system" follows the OS live.
      const media = matchMedia("(prefers-color-scheme: dark)")
      const buttons = document.querySelectorAll<HTMLButtonElement>("button[data-theme]")
      let theme = "system"
      function apply() {
        const dark = theme === "dark" || (theme === "system" && media.matches)
        document.documentElement.classList.toggle("dark", dark)
        for (const button of buttons) {
          const selected = button.dataset.theme === theme
          button.setAttribute("aria-pressed", String(selected))
          button.classList.toggle("btn-outline", !selected)
        }
      }
      for (const button of buttons) {
        button.addEventListener("click", () => {
          theme = button.dataset.theme ?? "system"
          apply()
        })
      }
      media.addEventListener("change", apply)

      // Framework tabs and package-manager switchers: one choice for the whole site, remembered.
      type Choice = "framework" | "pm"
      function choose(key: Choice, value: string) {
        document.documentElement.dataset[key] = value
        try {
          localStorage.setItem(`vinui:${key}`, value)
        } catch {}
        syncSelected()
      }
      function syncSelected() {
        const { framework, pm } = document.documentElement.dataset
        for (const tab of document.querySelectorAll<HTMLElement>("[data-framework-tab]"))
          tab.setAttribute("aria-selected", String(tab.dataset.frameworkTab === framework))
        for (const tab of document.querySelectorAll<HTMLElement>("[data-pm-tab]"))
          tab.setAttribute("aria-pressed", String(tab.dataset.pmTab === pm))
      }
      document.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>("[data-framework-tab], [data-pm-tab], [data-copy]")
        if (!target) return
        if (target.dataset.frameworkTab) choose("framework", target.dataset.frameworkTab)
        else if (target.dataset.pmTab) choose("pm", target.dataset.pmTab)
        else {
          const block = target.closest("[data-install]")
          const code = block?.querySelector(`[data-pm-panel="${document.documentElement.dataset.pm}"] pre`)?.textContent
          if (code) void navigator.clipboard?.writeText(code.trim()).then(() => {
            target.textContent = "Copied"
            setTimeout(() => (target.textContent = "Copy"), 1500)
          })
        }
      })
      // Arrow keys move between framework tabs.
      document.addEventListener("keydown", (event) => {
        const tab = (event.target as HTMLElement).closest<HTMLElement>("[data-framework-tab]")
        if (!tab || (event.key !== "ArrowRight" && event.key !== "ArrowLeft")) return
        const tabs = [...tab.parentElement!.querySelectorAll<HTMLElement>("[data-framework-tab]")]
        const next = tabs[(tabs.indexOf(tab) + (event.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length]
        next.focus()
        choose("framework", next.dataset.frameworkTab!)
      })
      syncSelected()
    </script>
  </body>
</html>
