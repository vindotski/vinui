{
  "name": "playground-svelte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "registry:add": "shadcn-svelte add http://localhost:4321/r/svelte/button.json http://localhost:4321/r/svelte/dialog.json --yes --overwrite"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.72.0",
    "@sveltejs/adapter-auto": "8.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "shadcn-svelte": "1.8.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
