{
  "name": "vinui",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:docs": "pnpm --filter docs dev",
    "registry:build": "pnpm --filter @vinui/registry-build build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
