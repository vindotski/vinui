{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "../packages/native/*"
      ],
      "$lib/*": [
        "../packages/svelte/src/lib/*"
      ]
    }
  },
  "include": [
    "env.d.ts",
    "parity",
    "specs",
    "*.config.ts"
  ]
}
