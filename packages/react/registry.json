{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "vinui",
  "homepage": "https://vinui.dev",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "cn() helper: clsx + tailwind-merge.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Button built on Base UI, styled with vinui btn classes.",
      "dependencies": ["@base-ui/react"],
      "registryDependencies": ["@vinui/utils"],
      "files": [
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
