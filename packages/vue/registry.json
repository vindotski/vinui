{
  "$schema": "https://shadcn-vue.com/schema/registry.json",
  "name": "vinui",
  "homepage": "https://vinui.dev",
  "items": [
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Button built on Reka UI, styled with vinui btn classes.",
      "dependencies": [
        "reka-ui",
        "clsx",
        "cn"
      ],
      "files": [
        {
          "path": "components/ui/button/Button.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/button/index.ts",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "dialog",
      "type": "registry:ui",
      "title": "Dialog",
      "description": "Modal dialog built on Reka UI, styled with vinui dialog classes.",
      "dependencies": [
        "reka-ui",
        "cn"
      ],
      "registryDependencies": [
        "@vinui/button"
      ],
      "files": [
        {
          "path": "components/ui/dialog/Dialog.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/dialog/DialogClose.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/dialog/DialogContent.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/dialog/DialogDescription.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/dialog/DialogFooter.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/dialog/DialogHeader.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/dialog/DialogOverlay.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/dialog/DialogPortal.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/dialog/DialogTitle.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/dialog/DialogTrigger.vue",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/dialog/index.ts",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
